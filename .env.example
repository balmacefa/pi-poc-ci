# Copy to .env (git-ignored) and fill in only the providers you use.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Claude can also use a subscription token instead of the API key:
# ANTHROPIC_OAUTH_TOKEN=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Path to the local pi checkout linked into the container (default: ../pi-harness-src/packages/coding-agent).
# PI_LOCAL_DIR=C:/Users/fabia/pi-harness-src/packages/coding-agent

# npm version of pi installed in the image when no local build is mounted.
# PI_VERSION=latest
